# Render Web Service 환경변수
ADMIN_PASSWORD=your-secure-password

# Render PostgreSQL (Blueprint 사용 시 자동 연결)
# DATABASE_URL=postgresql://...

# Firebase Storage (onandme 프로젝트 서비스 계정 JSON 전체를 한 줄로)
# Firebase Console → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"onnme-website",...}
FIREBASE_STORAGE_BUCKET=onnme-website.firebasestorage.app

# 로컬 개발: 위 변수 없이 npm start → JSON + uploads/ 폴더 사용
